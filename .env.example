# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Supabase service key: never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Encrypt gateway access secrets and WhatsApp tokens. 32 bytes / 64 hex chars.
GYMFLOW_ENCRYPTION_KEY=
GYMFLOW_WORKER_SECRET=
CRON_SECRET=

# Per-gym Razorpay credentials are entered in the gym Settings screen.
# Platform billing uses a wholly separate Razorpay account:
PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=
PLATFORM_RAZORPAY_WEBHOOK_SECRET=

# Meta app-level webhook validation; each gym stores its own WABA token encrypted.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
